# -----------------------------
# godrays_bright.pbrt — PBRT-v4
# -----------------------------

# Global setup
LookAt     0 2 10   0 1 0   0 1 0
Camera     "perspective" "float fov" [40]

Sampler    "halton"  "integer pixelsamples" [128]
Integrator "volpath" "integer maxdepth" [6]
Film       "rgb"     "string filename" "godrays_bright.png"
                        "integer xresolution" [800]
                        "integer yresolution" [600]

# God-ray medium (strong shafts, very low absorption)
MakeNamedMedium "godray" "string type" "homogeneous"
    "rgb sigma_s" [0.5    0.5    0.5]
    "rgb sigma_a" [0.005  0.005  0.005]
    "float g"     [0.92]

WorldBegin

  # Key light: strong, warm quad
  AttributeBegin
    AreaLightSource "diffuse" "rgb L" [2000 1800 1500]
    Translate  0 8  -2
    Rotate     -45 1 0 0
    Shape      "bilinearmesh"
        "point3 P"  [ -2 -2 0   2 -2 0   -2 2 0   2 2 0 ]
        "point2 uv" [  0  0     1  0     1  1     0 1 ]
  AttributeEnd

  # Fill light: neutral, to reveal the interior object
  LightSource "point"
      "point3 from" [ 0 2 10 ]
      "rgb I"     [400 400 400]

  # God-ray volume: larger and closer
  AttributeBegin
    Material      "interface"
    MediumInterface "godray" ""

    Translate  0 3 2
    Rotate     -30 1 0 0
    Scale      2 6 2
    Shape      "sphere"  "float radius" [1]
  AttributeEnd

  # Object inside the shafts
  AttributeBegin
    Material "diffuse" "rgb reflectance" [0.8 0.8 0.8]
    Translate 0 1 0
    Shape    "sphere"  "float radius" [1]
  AttributeEnd

  # Ground (outside volume)
  AttributeBegin
    Material  "diffuse" "rgb reflectance" [0.5 0.5 0.5]
    Translate 0 -101 0
    Shape     "sphere" "float radius"   [100]
  AttributeEnd

# (EOF → render)
